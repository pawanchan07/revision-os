<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Revision OS</string>
    <string name="channel_name">Learning nudges</string>
    <string name="channel_desc">Your next mission, reviews that are due, and a streak warning. Two a day at most.</string>
    <string name="nudge_label">Your next discovery</string>
    <string name="act_start">Start</string>
    <string name="act_later">Later</string>
    <string name="act_later_long">Not now. Remind me in an hour</string>
    <string name="act_reveal">Show answer</string>
    <string name="act_got">Got it</string>
    <string name="act_missed">Missed it</string>
    <color name="revos_bg">#080912</color>
    <color name="revos_accent">#8F7DFF</color>

    <!-- Dark window and system bars, so nothing flashes white before the first paint.
         The window background doubles as the splash on Android 11 and below. -->
    <style name="RevosTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/revos_bg</item>
        <item name="android:navigationBarColor">@color/revos_bg</item>
        <item name="android:colorAccent">@color/revos_accent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
